    def start_record(self):
        '''
        Start record
        '''
        # Prepare video writer if need to record
        if not self.is_show_debug_window:
            self.enable_viz()

        # Make sure video/ exist
        os.makedirs("video", exist_ok=True)
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        path = os.path.join("video", f"{timestamp}.mp4")

        # Get video writer
        fourcc = cv2.VideoWriter_fourcc(*'mp4v')  # mp4 codec
        self.video_writer = cv2.VideoWriter(path, fourcc, 10, WINDOW_WORKING_SIZE)

        logger.info(f"[start_record] Record video to {path}")

    def stop_record(self):
        '''
        Stop Record
        '''
        self.video_writer = None
        logger.info("[stop_record] Stop recording")


    def _nametag_reacquire_box_from_minimap(self, img_w, img_h, search_left, search_top):
        """Bias nametag reacquire ROI using minimap player position.

        Default edge margin is 10% of minimap width/height (configurable via
        nametag.minimap_edge_frac). If the player is more than that margin
        inward from all edges, treat as center and search the window center.
        If within 10% of any edge, bias the search ROI toward that screen side.
        """
        nametag_cfg = self.cfg.get("nametag", {}) or {}
        edge_frac = float(nametag_cfg.get("minimap_edge_frac", 0.10))
        center_frac = float(nametag_cfg.get("reacquire_center_frac", 0.55))
        side_frac = float(nametag_cfg.get("reacquire_side_frac", 0.62))

        play_w = max(1, img_w - search_left)
        play_h = max(1, img_h - search_top)

        loc = getattr(self, "loc_player_minimap", None)
        mini = getattr(self, "img_minimap", None)
        use_center = True
        bias_x = 0.5
        bias_y = 0.45  # nametag sits above body
        if (
            loc is not None
            and mini is not None
            and getattr(mini, "size", 0) != 0
            and len(getattr(mini, "shape", ())) >= 2
        ):
            mh, mw = mini.shape[:2]
            if mw > 4 and mh > 4:
                mx, my = float(loc[0]), float(loc[1])
                nx = max(0.0, min(1.0, mx / float(mw)))
                ny = max(0.0, min(1.0, my / float(mh)))
                near_left = nx <= edge_frac
                near_right = nx >= 1.0 - edge_frac
                near_top = ny <= edge_frac
                near_bottom = ny >= 1.0 - edge_frac
                if near_left or near_right or near_top or near_bottom:
                    use_center = False
                    bias_x = nx
                    bias_y = ny

        if use_center:
            box_w = max(80, int(play_w * center_frac))
            box_h = max(80, int(play_h * center_frac))
            cx = search_left + play_w // 2
            cy = search_top + int(play_h * 0.45)
        else:
            box_w = max(80, int(play_w * side_frac))
            box_h = max(80, int(play_h * side_frac))
            cx = search_left + int(bias_x * play_w)
            cy = search_top + int(bias_y * play_h)

        x0 = int(cx - box_w // 2)
        y0 = int(cy - box_h // 2)
        x1 = x0 + box_w
        y1 = y0 + box_h
        x0 = max(search_left, min(x0, img_w - 1))
        y0 = max(search_top, min(y0, img_h - 1))
        x1 = max(x0 + 1, min(x1, img_w))
        y1 = max(y0 + 1, min(y1, img_h))
        return (x0, y0, x1, y1)

    def get_player_location_by_nametag(self):
        '''
        Detects the player's location based on the nametag position in the game window.

        This function works by:
        - Extracting a vertical region of interest (ROI) where the nametag is expected.
        - Ignoring the top UI strip, where the party list repeats the same name.
        - Matching the complete nametag (hard two-row name+medal when the template
          includes both) at several scales.
        - Searching near the last valid position before doing a global reacquisition.
        - Computing the player's center position by applying a fixed offset to the
          nametag top (name-row top / full-stack top for prepared two-row crops).

        Returns:
            loc_player (tuple): The (x, y) coordinates of the player's estimated location.
        '''
        if self.img_nametag is None or self.img_nametag_gray is None:
            return None

        nametag_cfg = self.cfg["nametag"]
        mode = nametag_cfg.get("mode", "color")
        camera_bottom = self.cfg["ui_coords"]["ui_y_start"]

        # Get nametag image and search image.
        if mode == "color":
            img_roi = self.img_frame[:camera_bottom, :]
            img_nametag = self.img_nametag
        elif mode == "white_mask":
            # Apply Gaussian blur for smoother white detection
            img_camera = cv2.GaussianBlur(
                self.img_frame_gray[:camera_bottom, :], (3, 3), 0
            )
            img_nametag = cv2.GaussianBlur(self.img_nametag_gray, (3, 3), 0)
            lower_white, upper_white = (150, 255)
            img_roi = cv2.inRange(img_camera, lower_white, upper_white)
            img_nametag  = cv2.inRange(img_nametag, lower_white, upper_white)
        elif mode == "grayscale":
            img_roi = self.img_frame_gray[:camera_bottom, :]
            img_nametag = self.img_nametag_gray
        elif mode == "histogram_eq":
            # Apply histogram equalization
            img_nametag_eq = cv2.equalizeHist(self.img_nametag_gray)
            img_camera_eq = cv2.equalizeHist(
                self.img_frame_gray[:camera_bottom, :]
            )

            # Apply global (fixed) threshold
            _, img_nametag = cv2.threshold(img_nametag_eq, 150, 255, cv2.THRESH_BINARY)
            _, img_roi = cv2.threshold(img_camera_eq, 150, 255, cv2.THRESH_BINARY)
        else:
            logger.error(f"Unsupported nametag detection mode: {mode}")
            return

        mask = nametag_match_mask(self.img_nametag)
        scales = nametag_cfg.get(
            "template_scales",
            ((0.95, 0.90), (0.95, 0.95), (1.0, 1.0)),
        )
        threshold = float(nametag_cfg.get("diff_thres", 0.18))
        search_top = max(0, int(nametag_cfg.get("search_top", 100)))
        # Skip left HUD / minimap; top-left UI often false-locks CMS nametags.
        search_left = max(0, int(nametag_cfg.get("search_left", 140)))
        search_margin = max(20, int(nametag_cfg.get("search_margin", 120)))
        reacquire_after = max(
            1, int(nametag_cfg.get("reacquire_after_misses", 2))
        )
        # Keep a cached lock only while the local score stays clearly good.
        cache_keep_thres = float(
            nametag_cfg.get("cache_keep_thres", min(threshold, 0.14))
        )

        def _in_play_field(loc):
            return loc[0] >= search_left and loc[1] >= search_top

        require_plate = mode == "color"
        match = None
        match_source = "global"
        # Drop a cached lock that already sits in the forbidden HUD strip.
        if self.nametag_match_valid and not _in_play_field(self.loc_nametag):
            self.nametag_match_valid = False
            self.nametag_miss_count = reacquire_after

        if self.nametag_match_valid:
            last_height, last_width = self.nametag_last_size
            last_x, last_y = self.loc_nametag
            # Pad below so a full two-row stack still fits when size was stale.
            local_box = (
                max(search_left, last_x - search_margin),
                max(search_top, last_y - search_margin),
                last_x + max(last_width, 1) + search_margin,
                last_y + max(last_height, 1) + search_margin,
            )
            local_match = find_best_nametag_match(
                img_roi,
                img_nametag,
                mask,
                scales,
                local_box,
                require_plate=require_plate,
            )
            local_ok = False
            if local_match is not None and _in_play_field(local_match[0]):
                if local_match[1] < threshold:
                    local_ok = True
                elif require_plate:
                    loc, local_score, local_size, _ = local_match
                    local_roi = img_roi[
                        loc[1]:loc[1] + local_size[0],
                        loc[0]:loc[0] + local_size[1],
                    ]
                    if (
                        local_score < float(nametag_cfg.get("occluded_diff_thres", 0.36))
                        and plate_support(local_roi) >= float(
                            nametag_cfg.get("occluded_plate_support", 0.28)
                        )
                    ):
                        local_ok = True
            if local_ok:
                local_score = local_match[1]
                # Prefer re-search when the cached score has degraded — holding a
                # weak "cached" lock is what drops the character in combat FX.
                score_degraded = (
                    local_score > cache_keep_thres
                    or local_score > self.nametag_last_score + 0.06
                )
                if score_degraded:
                    self.nametag_miss_count += 1
                    # Fall through to global for a fresher lock.
                    match = None
                else:
                    match = local_match
                    match_source = "cached"
                    self.nametag_miss_count = 0
            else:
                self.nametag_miss_count += 1
                # Do not return None for several frames — immediately allow
                # global reacquisition so combat FX cannot drop the player.
                if self.nametag_miss_count < reacquire_after:
                    # Brief grace: reuse last pose only for 1 frame if configured,
                    # otherwise fall through to global below.
                    pass
                self.nametag_match_valid = False

        if match is None:
            # Lost lock: minimap-biased ROI + full-frame candidates, then gate.
            # Prefer in-ROI hits; reject a strong out-of-ROI score when an
            # acceptable in-ROI peak exists (anti false-lock at wrong y).
            biased_box = self._nametag_reacquire_box_from_minimap(
                img_roi.shape[1],
                img_roi.shape[0],
                search_left,
                search_top,
            )
            global_box = (
                search_left,
                search_top,
                img_roi.shape[1],
                img_roi.shape[0],
            )
            biased_cands = find_nametag_match_candidates(
                img_roi,
                img_nametag,
                mask,
                scales,
                biased_box,
                require_plate=require_plate,
                top_k=8,
                max_keep=6,
            )
            global_cands = find_nametag_match_candidates(
                img_roi,
                img_nametag,
                mask,
                scales,
                global_box,
                require_plate=require_plate,
                top_k=8,
                max_keep=6,
            )
            merged = []
            for src, group in (("minimap_bias", biased_cands), ("global", global_cands)):
                for cand in group:
                    merged.append((cand, src))
            flat = [c for c, _src in merged]
            gated = pick_nametag_candidate(
                flat,
                prefer_box=biased_box,
                threshold=threshold,
                accept_thres=float(
                    nametag_cfg.get("occluded_diff_thres", 0.36)
                ),
                min_peak_sep=int(nametag_cfg.get("ambiguity_min_sep", 90)),
            )
            if gated is not None:
                match = gated
                gx, gy = int(gated[0][0]), int(gated[0][1])
                bx0, by0, bx1, by1 = biased_box
                in_bias = bx0 <= gx < bx1 and by0 <= gy < by1
                match_source = "roi_gate" if in_bias else "global_fallback"
                for cand, src in merged:
                    if (
                        int(cand[0][0]) == gx
                        and int(cand[0][1]) == gy
                        and abs(float(cand[1]) - float(gated[1])) < 1e-6
                    ):
                        if src == "minimap_bias":
                            match_source = "minimap_bias"
                        elif in_bias:
                            match_source = "roi_gate"
                        else:
                            match_source = "global_fallback"
                        break

        if match is None:
            return None
        loc_nametag, score, matched_size, matched_scale = match
        # Hard reject HUD / minimap false positives even if matcher returned them.
        if not _in_play_field(loc_nametag):
            self.nametag_match_valid = False
            return None
        matched_roi = img_roi[
            loc_nametag[1]:loc_nametag[1] + matched_size[0],
            loc_nametag[0]:loc_nametag[0] + matched_size[1],
        ]
        if score >= threshold:
            # Overlapping monster/player names inflate SQDIFF. Keep the hit if
            # the matched region is still clearly a cyan nameplate.
            occluded_threshold = float(nametag_cfg.get("occluded_diff_thres", 0.36))
            occluded_support = float(nametag_cfg.get("occluded_plate_support", 0.28))
            if not (
                require_plate
                and score < occluded_threshold
                and plate_support(matched_roi) >= occluded_support
            ):
                return None
            match_source = "occluded"

        # loc_nametag is the top-left of the matched template. For hard two-row
        # templates this is the full stack top (≈ name-row top). matched_size is
        # the scaled full template (name+medal) so the debug box covers both rows.
        # Player pose uses nametag top-center minus offset_y (name-row top → body).
        self.loc_nametag = loc_nametag
        self.nametag_last_size = matched_size
        self.nametag_last_score = float(score)
        self.nametag_match_valid = True
        self.nametag_miss_count = 0

        # Pre-change / upstream behavior: only offset_y is applied.
        # offset[0] is ignored so config defaults like [-50, 30] do not shift X.
        _, offset_y = self.cfg["nametag"]["offset"]
        scale_x, scale_y = matched_scale
        loc_player = (
            self.loc_nametag[0] + matched_size[1] // 2,
            self.loc_nametag[1] - round(offset_y * scale_y),
        )

        # Draw name tag detection box for debugging (full two-row when applicable)
        if self.img_frame_debug is not None:
            draw_rectangle(self.img_frame_debug, self.loc_nametag,
                           matched_size, (0, 255, 0), "")
            text = (
                f"NameTag,{round(score, 2)},{match_source},"
                f"{round(scale_x, 2)}x{round(scale_y, 2)}"
            )
            cv2.putText(self.img_frame_debug, text,
                        (self.loc_nametag[0],
                         self.loc_nametag[1] + matched_size[0] + 30),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)

        return loc_player


    def get_player_location_by_party_red_bar(self):
        '''
        get_player_location_by_party_red_bar
        '''
        # Zero out minimap area in the img_frame
        img_frame = self.img_frame.copy()
        x, y = self.loc_minimap
        h, w = self.img_minimap.shape[:2]
        img_frame[y:y+h, x:x+w] = 0

        # Get camera area
        img_camera = img_frame[:self.cfg["ui_coords"]["ui_y_start"], :]

        # Convert to HSV
        img_hsv = cv2.cvtColor(img_camera, cv2.COLOR_BGR2HSV)
        lower_red = to_opencv_hsv(self.cfg["party_red_bar"]["lower_red"])
        upper_red = to_opencv_hsv(self.cfg["party_red_bar"]["upper_red"])
        mask_red = cv2.inRange(img_hsv, lower_red, upper_red)
        # cv2.imshow("mask_red", mask_red)

        # Find contours on mask_red
        contours, _ = cv2.findContours(mask_red, cv2.RETR_EXTERNAL,
                                       cv2.CHAIN_APPROX_SIMPLE)

        # Filter contour by specific geometry trait of red bar
        boxs = []
        for c in contours:
            x, y, w, h = cv2.boundingRect(c)
            area = cv2.contourArea(c)
            fill_rate = float(area) / (h*w)
            if 5 <= h <= 7 and 1 <= w <= 50 and 10 <= area and fill_rate >= 0.7:
                # cv2.drawContours(self.img_frame_debug, [c], -1, (0, 255, 0), 1)
                boxs.append((x, y, w, h))

        if not boxs:
            return None, None  # red bar not found

        # Sort box by area
        boxs.sort(key=lambda box: box[2] * box[3], reverse=True)

        # Consider the biggest area as party red bar
        x, y, w, h = boxs[0]

        # Offset coordinate
        loc_party_red_bar = (x, y)
        loc_player = (x + self.cfg["party_red_bar"]["offset"][0],
                      y + self.cfg["party_red_bar"]["offset"][1])

        # visualize for debug
        if self.img_frame_debug is not None:
            draw_rectangle(self.img_frame_debug, loc_party_red_bar,
                        (h, w), (0, 255, 0), "party red bar", thickness=1, text_height=0.4)

        return loc_player, loc_party_red_bar

    def _smart_patrol_phase(self):
        fsm = getattr(self, "fsm", None)
        state = getattr(fsm, "state", None) if fsm is not None else None
        return getattr(state, "phase", None)

    def _need_debug_canvas_this_frame(self):
        """Allocate a full-frame debug copy only when overlay/recording needs it."""
        self._debug_canvas_this_frame = False
        if self.video_writer:
            self._debug_canvas_this_frame = True
            return True
        if not self.is_show_debug_window:
            return False
        debug_ui_fps = max(
            1.0,
            float(self.cfg.get("system", {}).get("fps_limit_debug_ui", 10) or 10),
        )
        now = time.time()
        if now - float(getattr(self, "t_last_debug_ui", 0.0)) >= 1.0 / debug_ui_fps:
            self._debug_canvas_this_frame = True
            return True
        return False

    def _need_frame_gray(self):
        nametag_cfg = self.cfg.get("nametag") or {}
        if not nametag_cfg.get("enable"):
            return False
        mode = str(nametag_cfg.get("mode", "color")).lower()
        if mode == "color":
            return False
        return self._should_run_nametag()

    def _should_run_nametag(self):
        """Nametag is costly; skip in smart_patrol Scan/Return when minimap is OK."""
        cached = getattr(self, "_nametag_run_this_frame", None)
        if cached is not None:
            return cached
        nametag_cfg = self.cfg.get("nametag") or {}
        if not nametag_cfg.get("enable"):
            self._nametag_run_this_frame = False
            return False
        if self.cfg.get("bot", {}).get("mode") != "smart_patrol":
            self._nametag_run_this_frame = True
            return True
        phase = self._smart_patrol_phase()
        if phase == "engage" or self.is_engaging():
            self._nametag_run_this_frame = True
            return True
        skip_ok = nametag_cfg.get("skip_when_minimap_ok", True)
        if isinstance(skip_ok, str):
            skip_ok = skip_ok.strip().lower() in ("1", "true", "yes", "on")
        if not skip_ok:
            self._nametag_run_this_frame = True
            return True
        if not getattr(self, "is_player_minimap_detected", False):
            self._nametag_run_this_frame = True
            return True
        try:
            scan_n = int(nametag_cfg.get("scan_every_n_frames", 0) or 0)
        except (TypeError, ValueError):
            scan_n = 0
        if scan_n <= 0:
            self._nametag_run_this_frame = False
            return False
        self._nametag_scan_tick = int(getattr(self, "_nametag_scan_tick", 0)) + 1
        run = (self._nametag_scan_tick % scan_n) == 0
        self._nametag_run_this_frame = run
        return run

    def _should_run_monster_detect(self):
        """Throttle template matching in smart_patrol Scan/Return; Engage always."""
        try:
            n = int(
                (self.cfg.get("monster_detect") or {}).get("detect_every_n_frames", 1)
                or 1
            )
        except (TypeError, ValueError):
            n = 1
        n = max(1, n)
        if n <= 1:
            return True
        if self.cfg.get("bot", {}).get("mode") != "smart_patrol":
            return True
        if self._smart_patrol_phase() == "engage" or self.is_engaging():
            return True
        tick = int(getattr(self, "_monster_detect_tick", 0))
        run = (tick % n) == 0
        self._monster_detect_tick = tick + 1
        return run

    def get_player_location(self):
        """Locate the player without requiring a party health bar."""
        detect_cfg = self.cfg.get("player_detect", {})
        mode = detect_cfg.get("mode", "auto")

        if mode in ("auto", "nametag") and self.cfg["nametag"].get("enable"):
            if self._should_run_nametag():
                loc_player = self.get_player_location_by_nametag()
                if loc_player is not None:
                    return loc_player
            elif self.loc_player != (0, 0):
                # Scan/Return: reuse last attack-center while minimap is driving motion.
                return self.loc_player
            if mode == "nametag":
                return self._get_player_location_fallback(detect_cfg)

        party_enabled = self.cfg["party_red_bar"].get("enable", False)
        if mode in ("auto", "party_red_bar") and party_enabled:
            loc_player, loc_party_red_bar = self.get_player_location_by_party_red_bar()
            if loc_party_red_bar is not None:
                self.loc_party_red_bar = loc_party_red_bar
            if loc_player is not None:
                return loc_player
            if mode == "party_red_bar":
                return self._get_player_location_fallback(detect_cfg)

        return self._get_player_location_fallback(detect_cfg)

    def _get_player_location_fallback(self, detect_cfg):
        if detect_cfg.get("fallback_to_last", True) and self.loc_player != (0, 0):
            return self.loc_player

        ratio_x, ratio_y = detect_cfg.get("screen_anchor_ratio", (0.5, 0.55))
        camera_height = min(self.cfg["ui_coords"]["ui_y_start"], self.img_frame.shape[0])
        return (
            int(self.img_frame.shape[1] * float(ratio_x)),
            int(camera_height * float(ratio_y)),
        )

    def get_player_location_on_global_map(self):
        '''
        get_player_location_on_global_map
        '''
        last_result = None if self.is_first_frame else self.loc_minimap_global
        self.loc_minimap_global, score, _ = match_minimap_on_map(
            self.img_map,
            self.img_minimap,
            last_result=last_result,
        )

        x_offset, y_offset = self.cfg["minimap"]["offset"]
        loc_player_global = (
            self.loc_minimap_global[0] + self.loc_player_minimap[0] + x_offset,
            self.loc_minimap_global[1] + self.loc_player_minimap[1] + y_offset
        )

        # Draw local minimap rectangle
        camera_bottom_right = (
            self.loc_minimap_global[0] + self.img_minimap.shape[1],
            self.loc_minimap_global[1] + self.img_minimap.shape[0]
        )
        cv2.rectangle(self.img_route_debug, self.loc_minimap_global,
                      camera_bottom_right, (0, 255, 255), 1)
        cv2.putText(
            self.img_route_debug,
            f"Minimap,score({round(score, 2)})",
            (self.loc_minimap_global[0], self.loc_minimap_global[1]+15),
            cv2.FONT_HERSHEY_SIMPLEX, 0.4,
            (0, 255, 255), 1
        )

        # Draw player center
        cv2.circle(self.img_route_debug,
                   loc_player_global, radius=2,
                   color=(0, 255, 255), thickness=-1)

        return loc_player_global

    def get_nearest_color_code(self):
        '''
        Searches for the nearest color-coded action marker
        around the player on the route map.

        This function:
        - Scans each pixel in the search box to find nearest color code
        - Tracks the closest matching pixel using Manhattan distance (|dx| + |dy|).
        - Returns a dictionary containing the nearest matching
          pixel's position, color, action label, and distance.

        Returns:
            dict or None: Dictionary containing:
                - "pixel": (x, y) coordinate of the matched pixel
                - "color": matched RGB color tuple
                - "action": corresponding action string from config
                - "distance": Manhattan distance from player
            Returns None if no matching color is found within the region.
        '''
        x0, y0 = self.loc_player_global
        h, w = self.img_route.shape[:2]
        x_min = max(0, x0 - self.cfg["route"]["search_range"])
        x_max = min(w, x0 + self.cfg["route"]["search_range"])
        y_min = max(0, y0 - self.cfg["route"]["search_range"])
        y_max = min(h, y0 + self.cfg["route"]["search_range"])

        nearest = None
        nearest_up_down = None
        min_dist = float('inf')
        min_dist_up_down = float('inf')
        for y in range(y_min, y_max):
            for x in range(x_min, x_max):
                pixel = tuple(self.img_route[y, x])  # (R, G, B)
                dist = abs(x - x0) + abs(y - y0)
                # Get nearest color
                if pixel in self.color_code and dist < min_dist:
                    nearest = {
                        "pixel": (x, y),
                        "color": pixel,
                        "command": self.color_code[pixel],
                        "distance": dist
                    }
                    min_dist = dist
                # Get nearest color (up, dowm)
                if pixel in self.color_code_up_down and dist < min_dist_up_down:
                    nearest_up_down = {
                        "pixel": (x, y),
                        "color": pixel,
                        "command": self.color_code_up_down[pixel],
                        "distance": dist
                    }
                    min_dist_up_down = dist

        # Debug
        draw_rectangle(
            self.img_route_debug,
            (x_min, y_min),
            (self.cfg["route"]["search_range"]*2,
             self.cfg["route"]["search_range"]*2),
            (0, 0, 255), "", text_height=0.4, thickness=1,
        )
        # Draw a straigt line from map_loc_player to color_code["pixel"]
        if nearest is not None:
            cv2.line(
                self.img_route_debug,
                self.loc_player_global, # start point
                nearest["pixel"],       # end point
                (0, 255, 0),            # green line
                1                       # thickness
            )
            # Print color code on debug image
            if self.img_frame_debug is not None:
                cv2.putText(
                    self.img_frame_debug, f"Route Action: {nearest['command']}",
                    (650, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255),
                    2, cv2.LINE_AA
                )
                cv2.putText(
                    self.img_frame_debug, f"Route Index: {self.idx_routes}",
                    (650, 90),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255),
                    2, cv2.LINE_AA
                )

        if nearest_up_down is not None:
            if self.img_frame_debug is not None:
                cv2.putText(
                    self.img_frame_debug, f"Route Action: {nearest_up_down['command']}",
                    (650, 60),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255),
                    2, cv2.LINE_AA
                )
            cv2.line(
                self.img_route_debug,
                self.loc_player_global,  # start point
                nearest_up_down["pixel"],# end point
                (0, 0, 255),             # green line
                1                        # thickness
            )

        return nearest, nearest_up_down  # if not found return none

    def get_attack_range(self, is_left=True):
        '''
        get_attack_range
        '''
        if self.cfg["bot"]["attack"] == "aoe_skill":
            dx = self.cfg["aoe_skill"]["range_x"] // 2
            dy = self.cfg["aoe_skill"]["range_y"] // 2
            x0 = max(0, self.loc_player[0] - dx)
            x1 = min(self.img_frame.shape[1], self.loc_player[0] + dx)
            y0 = max(0, self.loc_player[1] - dy)
            y1 = min(self.img_frame.shape[0], self.loc_player[1] + dy)

        elif self.cfg["bot"]["attack"] in ("directional", "hybrid"):
            if is_left:
                x0 = max(
                    0,
                    self.loc_player[0] - self.cfg["directional_attack"]["range_x"],
                )
                x1 = self.loc_player[0]
            else:
                x0 = self.loc_player[0]
                x1 = min(
                    self.img_frame.shape[1],
                    x0 + self.cfg["directional_attack"]["range_x"],
                )
            half_height = self.cfg["directional_attack"]["range_y"] // 2
            y0 = max(0, self.loc_player[1] - half_height)
            y1 = min(self.img_frame.shape[0], self.loc_player[1] + half_height)
        else:
            raise RuntimeError(f"Unsupported attack mode: {self.cfg['bot']['attack']}")

        return (x0, y0, x1, y1)

    def get_aoe_attack_range(self):
        """Return the centered range used by AoE and hybrid crowd counting."""
        dx = self.cfg["aoe_skill"]["range_x"] // 2
        dy = self.cfg["aoe_skill"]["range_y"] // 2
        return (
            max(0, self.loc_player[0] - dx),
            max(0, self.loc_player[1] - dy),
            min(self.img_frame.shape[1], self.loc_player[0] + dx),
            min(self.img_frame.shape[0], self.loc_player[1] + dy),
        )

    def count_monsters_in_aoe_range(self):
        """Count independent detected monsters whose centers are in the AoE box."""
        x0, y0, x1, y1 = self.get_aoe_attack_range()
        count = 0
        for monster in self.monsters:
            mx, my = monster["position"]
            width, height = monster["size"]
            center_x = mx + width // 2
            center_y = my + height // 2
            if x0 <= center_x <= x1 and y0 <= center_y <= y1:
                count += 1
        return count

    def get_nearest_monster(self, is_left=True, monsters=None):
        '''
        Finds the nearest monster within the player's attack range.

        This function:
        - Defines an attack box relative to the player position,
            depending on the facing direction (`is_left`).
        - Iterates through all detected monsters and checks which ones overlap
          with the attack box.
        - Returns the closest valid monster that meets the overlap criteria.

        Args:
            is_left (bool): If True, assume the player is facing left;
                            adjusts attack box accordingly.
        Returns:
            dict or None: The nearest monster's info dict, or None if no valid match.
        '''

        x0, y0, x1, y1 = self.get_attack_range(is_left=is_left)

        nearest_monster = None
        min_distance = float('inf')
        template_areas = [
            img.shape[0] * img.shape[1]
            for _, imgs in self.monsters_info.items()
            for img, _ in imgs
        ]
        max_trigger_area = self.cfg['monster_detect']['max_mob_area_trigger']
        reference_area = min(template_areas, default=max_trigger_area)
        inter_area_thres = min(reference_area, max_trigger_area)
        monster_list = monsters if monsters is not None else (
            getattr(self, "decision_monsters", None) or self.monsters
        )
        for monster in monster_list:
            mx1, my1 = monster["position"]
            mw, mh = monster["size"]
            mx2 = mx1 + mw
            my2 = my1 + mh

            # Calculate intersection
            ix1 = max(x0, mx1)
            iy1 = max(y0, my1)
            ix2 = min(x1, mx2)
            iy2 = min(y1, my2)

            iw = max(0, ix2 - ix1)
            ih = max(0, iy2 - iy1)
            inter_area = iw * ih

            if inter_area >= inter_area_thres:
                # Compute distance to player center
                monster_center = (mx1 + mw // 2, my1 + mh // 2)
                dx = monster_center[0] - self.loc_player[0]
                dy = monster_center[1] - self.loc_player[1]
                distance = abs(dx) + abs(dy)  # Manhattan distance

                if distance < min_distance:
                    min_distance = distance
                    nearest_monster = monster

        return nearest_monster

    def get_monsters_in_range(self, top_left, bottom_right):
        '''
        get_monsters_in_range
        '''
        x0, y0 = top_left
        x1, y1 = bottom_right

        img_roi = self.img_frame[y0:y1, x0:x1]

        # Shift player's location into ROI coordinate system
        px, py = self.loc_player
        px_in_roi = px - x0
        py_in_roi = py - y0

        # Define rectangle range around player (in ROI coordinate)
        char_x_min = max(0, px_in_roi - self.cfg["character"]["width"] // 2)
        char_x_max = min(img_roi.shape[1], px_in_roi + self.cfg["character"]["width"] // 2)
        char_y_min = max(0, py_in_roi - self.cfg["character"]["height"] // 2)
        char_y_max = min(img_roi.shape[0], py_in_roi + self.cfg["character"]["height"] // 2)

        monsters = []
        detect_mode = self.cfg["monster_detect"]["mode"]

        # Template-free mode must also work when the selected map has no bound monsters.
        if detect_mode == "template_free":
            black_mask = np.all(img_roi == [0, 0, 0], axis=2).astype(np.uint8) * 255
            black_mask[char_y_min:char_y_max, char_x_min:char_x_max] = 0
            kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (20, 20))
            closed_mask = cv2.morphologyEx(black_mask, cv2.MORPH_CLOSE, kernel)
            num_labels, _, stats, _ = cv2.connectedComponentsWithStats(
                closed_mask, connectivity=8
            )
            for i in range(1, num_labels):
                x, y, w, h, area = stats[i]
                if area > 1000:
                    monsters.append({
                        "name": "Template Free",
                        "position": (x0 + x, y0 + y),
                        "size": (w, h),
                        "score": 1.0,
                    })

        monster_templates = self.monsters_info.items() if detect_mode != "template_free" else []
        # contour_only: blur the ROI once per frame instead of once per template.
        contour_roi_blur = None
        if detect_mode == "contour_only" and self.cfg["bot"]["mode"] != "patrol":
            blur = int(self.cfg["monster_detect"].get("contour_blur", 5) or 5)
            if blur < 1:
                blur = 1
            if blur % 2 == 0:
                blur += 1
            mask_roi = np.all(img_roi == [0, 0, 0], axis=2).astype(np.uint8) * 255
            mask_roi[char_y_min:char_y_max, char_x_min:char_x_max] = 0
            contour_roi_blur = cv2.GaussianBlur(mask_roi, (blur, blur), 0)

        for monster_name, monster_imgs in monster_templates:
            contour_patterns = self.monsters_contour_patterns.get(monster_name)
            for idx, (img_monster, mask_monster) in enumerate(monster_imgs):
                if self.cfg["bot"]["mode"] == "patrol":
                    pass # Don't detect monster using template in patrol mode
                elif self.cfg["monster_detect"]["mode"] == "contour_only":
                    # Use only black lines contour to detect monsters
                    if contour_patterns is not None and idx < len(contour_patterns):
                        img_monster_blur = contour_patterns[idx]
                    else:
                        black_pixels = np.all(img_monster == [0, 0, 0], axis=2)
                        visible_pixels = mask_monster > 0
                        mask_pattern = (black_pixels & visible_pixels).astype(np.uint8) * 255
                        blur = int(self.cfg["monster_detect"].get("contour_blur", 5) or 5)
                        if blur % 2 == 0:
                            blur += 1
                        img_monster_blur = cv2.GaussianBlur(mask_pattern, (blur, blur), 0)

                    img_roi_blur = contour_roi_blur
                    if img_roi_blur is None:
                        continue

                    # Check template vs ROI size before matching
                    h_roi, w_roi = img_roi_blur.shape[:2]
                    h_temp, w_temp = img_monster_blur.shape[:2]

                    if h_temp > h_roi or w_temp > w_roi:
                        continue  # Skip only this template; other sources may still match.

                    # Perform template matching
                    res = cv2.matchTemplate(img_roi_blur, img_monster_blur, cv2.TM_SQDIFF_NORMED)

                    # Apply soft threshold
                    match_locations = np.where(res <= self.cfg["monster_detect"]["diff_thres"])

                    h, w = img_monster.shape[:2]
                    for pt in zip(*match_locations[::-1]):
                        monsters.append({
                            "name": monster_name,
                            "position": (pt[0] + x0, pt[1] + y0),
                            "size": (w, h),
                            "score": res[pt[1], pt[0]],
                        })
                elif self.cfg["monster_detect"]["mode"] == "grayscale":
                    img_monster_gray = cv2.cvtColor(img_monster, cv2.COLOR_BGR2GRAY)
                    img_roi_gray = cv2.cvtColor(img_roi, cv2.COLOR_BGR2GRAY)
                    res = cv2.matchTemplate(
                            img_roi_gray,
                            img_monster_gray,
                            cv2.TM_SQDIFF_NORMED,
                            mask=mask_monster)
                    match_locations = np.where(res <= self.cfg["monster_detect"]["diff_thres"])
                    h, w = img_monster.shape[:2]
                    for pt in zip(*match_locations[::-1]):
                        monsters.append({
                            "name": monster_name,
                            "position": (pt[0] + x0, pt[1] + y0),
                            "size": (w, h),
                            "score": res[pt[1], pt[0]],
                    })
                elif self.cfg["monster_detect"]["mode"] == "color":
                    res = cv2.matchTemplate(
                            img_roi,
                            img_monster,
                            cv2.TM_SQDIFF_NORMED,
                            mask=mask_monster)
                    match_locations = np.where(res <= self.cfg["monster_detect"]["diff_thres"])
                    h, w = img_monster.shape[:2]
                    for pt in zip(*match_locations[::-1]):
                        monsters.append({
                            "name": monster_name,
                            "position": (pt[0] + x0, pt[1] + y0),
                            "size": (w, h),
                            "score": res[pt[1], pt[0]],
                    })
                else:
                    logger.error(f"Unexpected camera localization mode: {self.cfg['monster_detect']['mode']}")
                    return []

        # Apply Non-Maximum Suppression to monster detection
        monsters = nms(monsters, iou_threshold=0.4)

        # Detect monster via health bar
        if self.cfg["monster_detect"]["with_enemy_hp_bar"]:
            # Create color mask for Monsters' HP bar
            mask = cv2.inRange(img_roi,
                               np.array(self.cfg["monster_detect"]["hp_bar_color"]),
                               np.array(self.cfg["monster_detect"]["hp_bar_color"]))

            # Find connected components (each cluster of green pixels)
            num_labels, labels, stats, centroids = \
                cv2.connectedComponentsWithStats(mask, connectivity=8)

            for i in range(1, num_labels):  # skip background (label 0)
                x, y, w, h, area = stats[i]
                if area < 3:  # small noise filter
                    continue

                # Guess a monster bounding box
                y += 10
                x = max(0, x)
                y = max(0, y)
                w = 70
                template_heights = [
                    img.shape[0]
                    for _, imgs in self.monsters_info.items()
                    for img, _ in imgs
                ]
                h = min(template_heights) if template_heights else self.cfg["character"]["height"]

                monsters.append({
                    "name": "Health Bar",
                    "position": (x0 + x, y0 + y),
                    "size": (w, h),
                    "score": 1.0,
                })

        # Debug overlays only when the monitor tab is active.
        if self.is_show_debug_window and self.img_frame_debug is not None:
            draw_rectangle(
                self.img_frame_debug, (x0, y0), (y1-y0, x1-x0),
                (255, 0, 0), "Mob Detection Box"
            )
            for monster in monsters:
                if monster["name"] == "Health Bar":
                    color = (0, 255, 255)
                else:
                    color = (0, 255, 0)
                draw_rectangle(
                    self.img_frame_debug,
                    monster["position"],
                    (monster["size"][1], monster["size"][0]),
                    color, str(round(monster['score'], 2))
                )

        # Health-bar and image-template detectors may describe the same mob.
        # Run one final suppression pass so hybrid mode does not count it twice.
        return nms(monsters, iou_threshold=0.3)

    def get_img_frame(self, log_failure=True):
        '''
        get_img_frame
        '''
        # Get window game raw frame
        self.frame = self.capture.get_frame()
        if self.frame is None:
            if log_failure:
                logger.warning("Failed to capture game frame.")
            return

        # Windows capture now returns the exact game client area. Legacy/macOS
        # backends may still include their title bar and keep the old path.
        if getattr(self.capture, "returns_client_frame", False):
            frame_no_title = self.frame
        else:
            frame_no_title = self.frame[
                self.cfg["game_window"]["title_bar_height"]:, :
            ]

        # Make sure the window ratio is as expected
        if self.args.test_image != "":
            pass # Disable size check if using test image for debugging
        elif getattr(self.capture, "returns_client_frame", False):
            if not is_img_16_to_9(frame_no_title, self.cfg):
                text = f"Unexpeted window size: {frame_no_title.shape[:2]} (expect window ratio 16:9)\n"
                text += "Please use windowed mode & smallest resolution."
                if log_failure:
                    logger.error(text)
                return
        elif self.cfg["bot"]["mode"] == "aux":
            if not is_img_16_to_9(frame_no_title, self.cfg): # Aux mode allow 16:9 resolution
                text = f"Unexpeted window size: {frame_no_title.shape[:2]} (expect window ratio 16:9)\n"
                text += "Please use windowed mode & smallest resolution."
                if log_failure:
                    logger.error(text)
                return
        else:
            # Other mode only allow specific resolution
            if self.cfg["game_window"]["size"] != frame_no_title.shape[:2]:
                text = f"Unexpeted window size: {frame_no_title.shape[:2]} "\
                       f"(expect {self.cfg['game_window']['size']})\n"
                text += "Please use windowed mode & smallest resolution."
                if log_failure:
                    logger.error(text)
                return

        return cv2.resize(frame_no_title, WINDOW_WORKING_SIZE,
                   interpolation=cv2.INTER_NEAREST)

    def get_immobile_seconds(self):
        """
        Seconds since the player last moved beyond watchdog.range.
        Resets the watchdog when movement is detected; does not pulse-reset
        on timeout so callers can track continuous stuck duration.

        Recent combat activity (Hybrid/AoE/directional attack or engage-hold)
        also resets the immobile clock so intentional standing AoE farming
        does not trigger Recovery false-stuck.
        """
        if self.loc_player_global is None or self.loc_watch_dog is None:
            return 0.0
        try:
            dx = abs(self.loc_player_global[0] - self.loc_watch_dog[0])
            dy = abs(self.loc_player_global[1] - self.loc_watch_dog[1])
        except (TypeError, IndexError):
            return 0.0

        current_time = time.time()
        if dx + dy > self.cfg["watchdog"]["range"]:
            self.loc_watch_dog = self.loc_player_global
            self.t_watch_dog = current_time
            return 0.0

        # Standing still while actively attacking nearby monsters is normal
        # for Hybrid AoE farming - treat recent combat as "not stuck".
        wd = self.cfg.get("watchdog", {}) if isinstance(self.cfg, dict) else {}
        combat_grace = float(wd.get("combat_grace_sec", 5))
        if combat_grace > 0:
            last_combat = max(
                float(getattr(self, "t_last_attack", 0.0) or 0.0),
                float(getattr(self, "t_last_aoe_attack", 0.0) or 0.0),
            )
            in_engage = False
            try:
                in_engage = bool(self.is_engaging())
            except Exception:
                in_engage = current_time < float(getattr(self, "engage_until", 0.0) or 0.0)
            aoe_mobs = int(getattr(self, "hybrid_aoe_monster_count", 0) or 0)
            if (
                (current_time - last_combat) <= combat_grace
                or in_engage
                or aoe_mobs >= 1
            ):
                self.loc_watch_dog = self.loc_player_global
                self.t_watch_dog = current_time
                return 0.0

        return current_time - self.t_watch_dog

    def is_player_stuck(self, reset_on_trigger=True):
        """
        Checks whether the player is stuck (not moving)
        based on their global position on map.

        This function:
        - Compares the player's current position with their last known position
          tracked by the watchdog.
        - If the player has moved beyond a threshold (`watch_dog_range`),
          it resets the watchdog timer.
        - If the player hasn't moved and the elapsed time exceeds (`watch_dog_timeout`),
          it flags the player as stuck.
        - When reset_on_trigger=True (legacy), watchdog is pulse-reset so random
          recovery fires about once per timeout window (patrol / rune find).
        - When reset_on_trigger=False, stuck stays True until the player moves
          (used by continuous recovery tracking).

        Returns:
            bool: True if the player is stuck, False otherwise.
        """
        dt = self.get_immobile_seconds()
        if dt > self.cfg["watchdog"]["timeout"]:
            if time.time() - float(getattr(self, "t_last_stuck_log", 0.0)) > 2.0:
                logger.warning(
                    f"[is_player_stuck] Player stuck for {round(dt, 2)} seconds."
                )
                self.t_last_stuck_log = time.time()
            if reset_on_trigger:
                # Legacy pulse: allow another stuck trigger after another timeout
                self.loc_watch_dog = self.loc_player_global
                self.t_watch_dog = time.time()
            return True
        return False

