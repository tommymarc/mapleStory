    def update_cmd_by_route(self):
        # get color code from img_route
        color_code, color_code_up_down = self.get_nearest_color_code()
        # Use color_code and color_code_up_down to complement each other
        # To prevent character stuck at the end of ladder, we use two color color pixels
        # and let them complement with each other, to ensure smoothy ladder climbing
        if color_code and color_code_up_down:
            if color_code["distance"] < color_code_up_down["distance"]:
                self.cmd_move_x, self.cmd_move_y, self.cmd_action = color_code["command"].split()
                _, cmd, _ = color_code_up_down["command"].split()
                if self.cmd_move_y == "none" and self.is_on_ladder:
                    self.cmd_move_y = cmd # only complement cmd_move_y when player is on ladder
            else:
                self.cmd_move_x, self.cmd_move_y, self.cmd_action = color_code_up_down["command"].split()
                cmd, _, _ = color_code["command"].split()
                if self.cmd_move_x == "none" and self.is_on_ladder:
                    self.cmd_move_x = cmd # only complement cmd_move_x when player is on ladder
        elif color_code:
            self.cmd_move_x, self.cmd_move_y, self.cmd_action = color_code["command"].split()
        elif color_code_up_down:
            self.cmd_move_x, self.cmd_move_y, self.cmd_action = color_code_up_down["command"].split()

        # teleport away from edge to avoid falling off cliff
        if self.is_near_edge() and \
            time.time() - self.t_last_teleport > self.cfg["teleport"]["cooldown"]:
            self.cmd_action = "teleport"
            self.t_last_teleport = time.time() # update timer

        # Use teleport while walking
        if self.cfg['teleport']['is_use_teleport_to_walk'] and \
            time.time() - self.t_last_teleport > self.cfg['teleport']['cooldown']:
            self.cmd_action = "teleport"
            self.t_last_teleport = time.time() # update timer

        # replace teleport to jump if user doesn't set teleport key
        if self.cfg["key"]["teleport"] == "" and self.cmd_action == "teleport":
            self.cmd_action = "jump"

    def _mob_detection_parameters(self):
        """Return the nearby scan radius and attack cooldown for this attack type."""
        margin = self.cfg["monster_detect"]["search_box_margin"]
        attack_mode = self.cfg["bot"]["attack"]
        if attack_mode == "aoe_skill":
            dx = self.cfg["aoe_skill"]["range_x"] // 2 + margin
            dy = self.cfg["aoe_skill"]["range_y"] // 2 + margin
            cooldown = self.cfg["aoe_skill"]["cooldown"]
        elif attack_mode == "directional":
            dx = self.cfg["directional_attack"]["range_x"] + margin
            dy = self.cfg["directional_attack"]["range_y"] + margin
            cooldown = self.cfg["directional_attack"]["cooldown"]
        elif attack_mode == "hybrid":
            dx = max(
                self.cfg["directional_attack"]["range_x"],
                self.cfg["aoe_skill"]["range_x"] // 2,
            ) + margin
            dy = max(
                self.cfg["directional_attack"]["range_y"],
                self.cfg["aoe_skill"]["range_y"] // 2,
            ) + margin
            cooldown = self.cfg["directional_attack"]["cooldown"]
        else:
            raise RuntimeError(f"Unsupported attack mode: {self.cfg['bot']['attack']}")

        return dx, dy, cooldown

    def detect_monsters_near_player(self):
        """Update the blue-box nearby-monster result without issuing an attack."""
        if not self._should_run_monster_detect():
            return self.monsters
        dx, dy, _cooldown = self._mob_detection_parameters()
        x0 = max(0                      , self.loc_player[0] - dx)
        x1 = min(self.img_frame.shape[1], self.loc_player[0] + dx)
        y0 = max(0                      , self.loc_player[1] - dy)
        y1 = min(self.img_frame.shape[0], self.loc_player[1] + dy)

        live = self.get_monsters_in_range((x0, y0), (x1, y1))
        self._update_monster_tracks(live)
        # Hybrid AoE must count live detections only (never soft/ghosts).
        self.hybrid_aoe_monster_count = (
            self.count_monsters_in_aoe_range()
            if self.cfg["bot"]["attack"] == "hybrid" else 0
        )
        self._draw_soft_monster_tracks()
        return self.monsters

    def _monster_track_enabled(self):
        raw = self._engage_cfg_value("monster_track_enable", False)
        if isinstance(raw, str):
            return raw.strip().lower() in ("1", "true", "yes", "on")
        return bool(raw)

    def _monster_track_ttl_sec(self):
        raw = self._engage_cfg_value("monster_track_ttl_sec", 0.4)
        try:
            return max(0.0, float(raw))
        except (TypeError, ValueError):
            return 0.4

    def _monster_track_match_dist(self):
        raw = self._engage_cfg_value("monster_track_match_dist", 80)
        try:
            return max(1.0, float(raw))
        except (TypeError, ValueError):
            return 80.0

    def _monster_track_soft_when_live_max(self):
        """If live count > this, ignore soft/ghosts for decision_monsters."""
        raw = self._engage_cfg_value("monster_track_soft_when_live_max", 1)
        try:
            return max(0, int(raw))
        except (TypeError, ValueError):
            return 1

    def _engage_side_sticky(self):
        """Keep engage_side until miss grace / no targets on that side."""
        raw = self._engage_cfg_value("engage_side_sticky", True)
        if isinstance(raw, str):
            return raw.strip().lower() in ("1", "true", "yes", "on")
        return bool(raw)

    def _pick_nearer_attack_side(self, monster_left, monster_right):
        """Pick nearer of left/right attack-range monsters; None if both empty."""
        def _dist(monster):
            if monster is None:
                return float("inf")
            mx, my = monster["position"]
            mw, mh = monster["size"]
            return abs(mx + mw // 2 - self.loc_player[0]) + \
                   abs(my + mh // 2 - self.loc_player[1])
        if monster_left is None and monster_right is None:
            return None
        if monster_left is not None and monster_right is None:
            return "left"
        if monster_right is not None and monster_left is None:
            return "right"
        return "left" if _dist(monster_left) <= _dist(monster_right) else "right"

    def _update_monster_tracks(self, live_detections, now=None):
        """Associate live detections into tracks; fill soft/decision lists."""
        now = time.time() if now is None else now
        if not hasattr(self, "monster_tracker") or self.monster_tracker is None:
            self.monster_tracker = MonsterTracker()
        if not self._monster_track_enabled():
            self.monster_tracker.clear()
            self.monsters = list(live_detections or [])
            self.soft_monsters = []
            self.decision_monsters = list(self.monsters)
            return self.decision_monsters

        live, soft = self.monster_tracker.update(
            live_detections or [],
            now=now,
            ttl_sec=self._monster_track_ttl_sec(),
            match_dist=self._monster_track_match_dist(),
        )
        self.monsters = live
        self.soft_monsters = soft
        # Soft fills gaps when live is empty/sparse; when crowded, live-only
        # for directional choice so ghosts behind the player cannot thrash side.
        soft_when_live_max = self._monster_track_soft_when_live_max()
        if len(live) > soft_when_live_max:
            self.decision_monsters = list(live)
        else:
            self.decision_monsters = list(live) + list(soft)
        return self.decision_monsters

    def has_soft_combat_target(self):
        """True when a soft/ghost track is still within TTL (alias: has_soft_target)."""
        return bool(getattr(self, "soft_monsters", None))

    def has_soft_target(self):
        return self.has_soft_combat_target()

