def load_optional_image(path, mode=cv2.IMREAD_COLOR):
    """Load a feature-specific image without aborting the whole bot startup."""
    if not os.path.exists(path):
        logger.warning(f"Optional image not found; related feature is unavailable: {path}")
        return None
    try:
        return load_image(path, mode)
    except (FileNotFoundError, ValueError):
        logger.warning(f"Optional image is unusable; related feature is unavailable: {path}")
        return None


