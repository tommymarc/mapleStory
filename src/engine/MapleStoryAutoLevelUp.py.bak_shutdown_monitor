            draw_rectangle(
                img,
                monster["position"],
                (monster["size"][1], monster["size"][0]),
                (0, 165, 255),  # orange (BGR)
                f"soft#{tid}",
            )

    def _engage_cfg_value(self, key, default):
        """Read engage timing: combat > hybrid_attack > bot."""
        for section in ("combat", "hybrid_attack", "bot"):
            block = self.cfg.get(section, {})
            if isinstance(block, dict) and key in block:
                return block[key]
        return default

    def _engage_hold_sec(self):
        raw = self._engage_cfg_value("engage_hold_sec", 1.2)
        try:
            return max(0.0, float(raw))
        except (TypeError, ValueError):
            return 1.2

    def _engage_miss_grace_sec(self):
        """Single miss grace while engaging with empty targets (stand+pulse)."""
        raw = self._engage_cfg_value("engage_miss_grace_sec", None)
        if raw is None:
            kill = self._engage_cfg_value("engage_miss_grace_kill_sec", None)
            flicker = self._engage_cfg_value("engage_miss_grace_flicker_sec", None)
            if kill is not None and flicker is not None:
                try:
                    if abs(float(kill) - float(flicker)) < 1e-9:
                        raw = kill
                except (TypeError, ValueError):
                    pass
            if raw is None:
                raw = flicker if flicker is not None else kill
            if raw is None:
                raw = 0.35
        try:
            return max(0.0, float(raw))
        except (TypeError, ValueError):
            return 0.35

    def _engage_miss_grace_kill_sec(self):
        """Alias for single-tier miss grace (backward compatible)."""
        return self._engage_miss_grace_sec()

    def _engage_miss_grace_flicker_sec(self):
        """Alias for single-tier miss grace (backward compatible)."""
        return self._engage_miss_grace_sec()

    def is_engaging(self):
        """True while finish-kill engage-hold is active."""
        return time.time() < float(getattr(self, "engage_until", 0.0))

    def clear_engage(self):
        self.engage_until = 0.0
        self.engage_side = None
        self.engage_miss_since = 0.0

    def _set_engage(self, side, hold_sec=None, now=None):
        """Remember engage side and extend finish-kill hold window."""
        now = time.time() if now is None else now
        if hold_sec is None:
            hold_sec = self._engage_hold_sec()
        if side in ("left", "right"):
            self.engage_side = side
        self.engage_until = now + float(hold_sec)
        self.engage_miss_since = 0.0


    def _hit_react_enabled(self):
        raw = self._engage_cfg_value("hit_react_enable", False)
        if isinstance(raw, str):
            return raw.strip().lower() in ("1", "true", "yes", "on")
        return bool(raw)

    def _hit_react_min_drop_percent(self):
        raw = self._engage_cfg_value("hit_react_min_drop_percent", 4.0)
        try:
            return max(0.0, float(raw))
        except (TypeError, ValueError):
            return 4.0

    def _hit_react_duration_sec(self):
        raw = self._engage_cfg_value("hit_react_duration_sec", 0.4)
        try:
            return max(0.0, float(raw))
        except (TypeError, ValueError):
            return 0.4

    def _hit_react_cooldown_sec(self):
        raw = self._engage_cfg_value("hit_react_cooldown_sec", 1.3)
        try:
            return max(0.0, float(raw))
        except (TypeError, ValueError):
            return 1.3

    def _hit_react_jump(self):
        raw = self._engage_cfg_value("hit_react_jump", True)
        if isinstance(raw, str):
            return raw.strip().lower() in ("1", "true", "yes", "on")
        return bool(raw)

    def _nearest_threat_side(self):
        """Nearest live (else decision) monster side relative to player."""
        live = getattr(self, "monsters", None) or []
        decision = getattr(self, "decision_monsters", None) or []
        pool = live if live else decision
        if not pool:
            return None
        px, py = self.loc_player
        best_side = None
        best_dist = float("inf")
        for monster in pool:
            mx, my = monster["position"]
            mw, mh = monster["size"]
            cx = mx + mw // 2
            cy = my + mh // 2
            dist = abs(cx - px) + abs(cy - py)
            if dist < best_dist:
                best_dist = dist
                best_side = "left" if cx < px else "right"
        return best_side

    def _pick_hit_react_retreat_dir(self):
        """Retreat opposite threat: engage_side > nearest monster > facing."""
        side = getattr(self, "engage_side", None)
        if side in ("left", "right"):
            return "right" if side == "left" else "left"
        threat = self._nearest_threat_side()
        if threat in ("left", "right"):
            return "right" if threat == "left" else "left"
        facing = getattr(getattr(self, "kb", None), "facing_direction", None)
        if facing in ("left", "right"):
            return "right" if facing == "left" else "left"
        return "left"

    def is_hit_reacting(self):
        """True while HIT_REACT retreat window is active."""
        return time.time() < float(getattr(self, "hit_react_until", 0.0))

    def update_hit_react_from_hp(self):
        """Read health_monitor.hp_percent; arm HIT_REACT on sharp drop."""
        hm = getattr(self, "health_monitor", None)
        if hm is None:
            return
        try:
            hp = hm.hp_percent
        except Exception:
            return
        if hp is None:
            return

        prev = getattr(self, "prev_hp_percent", None)
        now = time.time()
        if self._hit_react_enabled() and prev is not None:
            try:
                drop = float(prev) - float(hp)
            except (TypeError, ValueError):
                drop = 0.0
            min_drop = self._hit_react_min_drop_percent()
            cd = self._hit_react_cooldown_sec()
            active = now < float(getattr(self, "hit_react_until", 0.0))
            cooled = (
                now - float(getattr(self, "t_last_hit_react", 0.0)) >= cd
            )
            if drop >= min_drop and (not active) and cooled:
                retreat = self._pick_hit_react_retreat_dir()
                jump = self._hit_react_jump()
                self.hit_react_dir = retreat
                self.hit_react_need_jump = jump
                self.hit_react_until = now + self._hit_react_duration_sec()
                self.t_last_hit_react = now
                logger.info(
                    f"[HitReact] HP drop {drop:.1f}% -> retreat {retreat} "
                    f"jump={jump}"
                )

        self.prev_hp_percent = float(hp)

    def apply_hit_react_cmd(self):
        """Move away from threat; optional one-shot jump; pause attack."""
        direction = getattr(self, "hit_react_dir", None)
        if direction not in ("left", "right"):
            direction = self._pick_hit_react_retreat_dir()
            self.hit_react_dir = direction
        self.cmd_move_x = direction if direction in ("left", "right") else "none"
        self.cmd_move_y = "none"
        if getattr(self, "hit_react_need_jump", False):
            self.cmd_action = "jump"
            self.hit_react_need_jump = False
        else:
            self.cmd_action = "none"

    def handle_hit_react_frame(self):
        """
        HuntingState entry: if HIT_REACT active, keep monster tracks warm,
        apply retreat (no attack), send KB command, return True to skip route/mob.
        """
        if not self.is_hit_reacting():
            return False
        # Keep soft/live tracks alive without combat command overwrite
        try:
            if getattr(self, "img_frame", None) is not None:
                self.detect_monsters_near_player()
        except Exception as e:
            logger.debug(f"[HitReact] track refresh skipped: {e}")
        self.apply_hit_react_cmd()
        if getattr(self, "kb", None) is not None:
            self.kb.set_command(
                self.cmd_move_x + ' ' + self.cmd_move_y + ' ' + self.cmd_action
            )
        return True

    def update_cmd_by_mob_detection(self, use_cached=False):
        """Detect nearby monsters and update the combat command."""
        attack_mode = self.cfg["bot"]["attack"]
        _dx, _dy, cooldown = self._mob_detection_parameters()
        if not use_cached:
            self.detect_monsters_near_player()

        now = time.time()

        # Decision targets = live U soft(within TTL). Soft holds side through flicker;
        # hybrid AoE still uses live-only hybrid_aoe_monster_count.
        decision = getattr(self, "decision_monsters", None)
        if decision is None:
            decision = self.monsters
        # Check if no mob to attack (live and soft both empty / expired)
        if len(decision) == 0:
            # Single miss grace while engaging: stand + pulse for grace_sec, then clear.
            if (now < float(getattr(self, "engage_until", 0.0))
                    and getattr(self, "engage_side", None) in ("left", "right")):
                if float(getattr(self, "engage_miss_since", 0.0)) <= 0.0:
                    self.engage_miss_since = now
                    logger.debug("[Engage] Miss start: single grace (stand+pulse)")
                grace = self._engage_miss_grace_sec()
                if now - self.engage_miss_since > grace:
                    self.clear_engage()
                    self._reset_directional_attack_turn()
                    # Hunting skipped route because is_engaging was True at
                    # frame start — restore route now to avoid one-frame vacuum.
                    # smart_patrol has no route PNGs; leave cmd for its Scan phase.
                    if self.cfg.get("bot", {}).get("mode") == "normal" and self.img_routes:
                        self.update_cmd_by_route()
                        self.check_reach_goal()
                        logger.debug(
                            f"[Engage] Miss grace expired ({grace:.2f}s); resume route."
                        )
                    else:
                        logger.debug(
                            f"[Engage] Miss grace expired ({grace:.2f}s); "
                            "no route resume (non-normal mode)."
                        )
                    return
                self.cmd_move_x = "none"
                self.cmd_move_y = "none"
                self.cmd_action = "none"
                self._pulse_direction_then_attack(
                    self.engage_side, cooldown, now=now
                )
                return
            if now >= float(getattr(self, "engage_until", 0.0)):
                self.clear_engage()
            self._reset_directional_attack_turn()
            return

        # Monsters present again
        self.t_last_monster_seen = now
        self.engage_miss_since = 0.0

        # Update attack command
        if attack_mode == "aoe_skill":
            # Pure AoE: require live detection (soft/ghost alone is not enough)
            if len(self.monsters) > 0 and now - self.t_last_attack > cooldown:
                self.cmd_action = "attack"
                self.t_last_attack = now
                self._set_engage(getattr(self, "engage_side", None) or "left", now=now)

        elif attack_mode in ("directional", "hybrid"):
            if attack_mode == "hybrid":
                hybrid_cfg = self.cfg.get("hybrid_attack", {})
                trigger_count = max(2, int(hybrid_cfg.get(
                    "aoe_trigger_count", 2
                )))
                # Floor at 0.7s so hybrid AoE stays near attack recovery (~0.5-0.9s)
                # even if UI/config sets a very low aoe_cooldown (测谎 risk).
                aoe_cooldown = max(0.7, float(hybrid_cfg.get(
                    "aoe_cooldown", 0.9
                )))
                aoe_key = self.cfg.get("key", {}).get("aoe_skill", "")
                next_aoe = float(getattr(self, "t_next_aoe_attack", 0.0) or 0.0)
                if (self.hybrid_aoe_monster_count >= trigger_count
                        and aoe_key and now >= next_aoe):
                    self._reset_directional_attack_turn()
                    self.cmd_move_x = "none"
                    self.cmd_move_y = "none"
                    self.cmd_action = "aoe_attack"
                    self.t_last_aoe_attack = now
                    # Jitter next arm so dense packs do not press at a fixed Hz.
                    self.t_next_aoe_attack = now + aoe_cooldown * random.uniform(0.75, 1.35)
                    self.t_last_attack = now
                    # Hold position after AoE so route does not walk away mid-pack
                    side = getattr(self, "engage_side", None)
                    if side not in ("left", "right"):
                        side = "left"
                    self._set_engage(side, now=now)
                    logger.info(
                        "[Hybrid Attack] "
                        f"{self.hybrid_aoe_monster_count} monsters in AoE range; "
                        f"press '{aoe_key}'."
                    )
                    return
            # Get nearest monster to player (uses decision_monsters: live±soft)
            monster_left  = self.get_nearest_monster(is_left = True)
            monster_right = self.get_nearest_monster(is_left = False)

            # Sticky engage_side: prefer current side while it still has a target
            attack_direction = None
            sticky_side = getattr(self, "engage_side", None)
            if (self._engage_side_sticky()
                    and sticky_side in ("left", "right")):
                preferred = monster_left if sticky_side == "left" else monster_right
                if preferred is not None:
                    attack_direction = sticky_side

            if attack_direction is None:
                attack_direction = self.get_attack_direction(
                    monster_left, monster_right
                )

            if attack_direction is None:
                # Targets in attack range → never give route control.
                # Pick nearer side immediately and engage.
                if monster_left is not None or monster_right is not None:
                    attack_direction = self._pick_nearer_attack_side(
                        monster_left, monster_right
                    )
                else:
                    # Decision list may be non-empty but nothing in attack boxes
                    self._reset_directional_attack_turn()
                    return

            # Successful directional/hybrid attack decision -> engage-hold
            self._set_engage(attack_direction, now=now)

            # Route movement is generated earlier in this frame. Replace it
            # with a direction-only pulse, wait until the keyboard thread has
            # actually delivered that pulse, release movement, then attack.
            self.cmd_move_x = "none"
            self.cmd_move_y = "none"
            self.cmd_action = "none"
            self._pulse_direction_then_attack(attack_direction, cooldown, now=now)

    def _reset_directional_attack_turn(self):
        self.combat_turn_ready_at = 0.0
        self.combat_turn_pending_direction = None
        self.combat_turn_requested_at = 0.0

    def _pulse_direction_then_attack(self, attack_direction, cooldown, now=None):
        """Guarantee a delivered direction pulse before a directional attack."""
        now = time.time() if now is None else now
        if now - self.t_last_attack <= max(0.0, float(cooldown)):
            return False

        turn_delay = max(0.0, float(
            self.cfg["directional_attack"].get("character_turn_delay", 0.06)
        ))
        pending_direction = getattr(
            self, "combat_turn_pending_direction", None
        )
        if pending_direction != attack_direction:
            self.combat_turn_pending_direction = attack_direction
            self.combat_turn_requested_at = now
            self.combat_turn_ready_at = now + turn_delay
            self.cmd_move_x = attack_direction
            logger.debug(
                f"[Directional Attack] Turn pulse requested: {attack_direction}"
            )
            return False

        kb = getattr(self, "kb", None)
        requested_at = float(getattr(self, "combat_turn_requested_at", 0.0))
        delivered_at = getattr(kb, "t_last_direction_input", None)
        if delivered_at is None:
            direction_delivered = (
                getattr(kb, "facing_direction", None) == attack_direction
            )
        else:
            direction_delivered = float(delivered_at) >= requested_at > 0.0
        if not direction_delivered:
            self.cmd_move_x = attack_direction
            return False
        if now < float(getattr(self, "combat_turn_ready_at", 0.0)):
            return False

        self.cmd_move_x = "none"
        self.cmd_action = "attack"
        self.t_last_attack = now
        self._reset_directional_attack_turn()
        # Refresh engage window on each delivered attack
        self._set_engage(attack_direction, now=now)
        logger.debug(
            f"[Directional Attack] Facing {attack_direction}; attack delivered."
        )
        return True


    def _recovery_cfg(self):
        """Return recovery config dict with safe defaults."""
        return self.cfg.get("recovery", {}) if isinstance(self.cfg, dict) else {}

    def _recovery_enabled(self):
        raw = self._recovery_cfg().get("enable", True)
        if isinstance(raw, str):
            return raw.strip().lower() in ("1", "true", "yes", "on")
        return bool(raw)

    def _clear_recovery(self, log=False):
        if self.recovery_since is not None and log:
            elapsed = time.time() - float(self.recovery_since)
            logger.info(
                f"[Recovery] Recovered after {elapsed:.1f}s; resume normal hunting"
            )
        self.recovery_since = None
        self.recovery_clear_since = None

    def halt_for_recovery(self, reason):
        """Disable keyboard and terminate the bot after failed recovery."""
        logger.warning(f"[Recovery] Halt: {reason}; stop bot")
        try:
            if getattr(self, "kb", None) is not None:
                self.kb.set_command("none none none")
                self.kb.release_all_key()
                self.kb.disable()
                self.kb.is_terminated = True
        except Exception as e:
            logger.error(f"[Recovery] Halt keyboard cleanup failed: {e}")
        self.is_terminated = True
        self._clear_recovery(log=False)

    def handle_recovery_frame(self):
        """
        Stuck / off-route / minimap-lost recovery.

        Returns True if this frame was fully handled as recovery (caller should
        send the kb command and skip normal combat). Returns False when not
        in recovery so normal on-route hybrid farming continues.
        """
        if not self._recovery_enabled():
            self._clear_recovery(log=False)
            return False

        cfg = self._recovery_cfg()
        now = time.time()
        watchdog_timeout = float(self.cfg.get("watchdog", {}).get("timeout", 10))
        immobile = self.get_immobile_seconds()
        stuck = immobile >= watchdog_timeout

        minimap_lost = False
        if not getattr(self, "is_player_minimap_detected", True):
            if self.t_minimap_lost_since is None:
                self.t_minimap_lost_since = now
            lost_for = now - float(self.t_minimap_lost_since)
            if lost_for >= float(cfg.get("minimap_lost_sec", 3)):
                minimap_lost = True
        else:
            self.t_minimap_lost_since = None

        min_duration = float(cfg.get("min_duration_sec", 6))
        clear_grace = float(cfg.get("clear_stuck_grace_sec", 3))

        if not (stuck or minimap_lost):
            # Still in an active recovery window: require min pause + sustained free.
            if self.recovery_since is None:
                return False
            if self.recovery_clear_since is None:
                self.recovery_clear_since = now
            elapsed = now - float(self.recovery_since)
            free_for = now - float(self.recovery_clear_since)
            if elapsed >= min_duration and free_for >= clear_grace:
                self._clear_recovery(log=True)
                return False
            # Stay in recovery (pause attacks) until both conditions are met.
        else:
            # Currently stuck / minimap-lost: reset continuous free timer.
            self.recovery_clear_since = None

        if self.recovery_since is None:
            self.recovery_since = now
            self.recovery_clear_since = None
            logger.warning(
                "[Recovery] Enter: "
                f"stuck={stuck} immobile={immobile:.1f}s "
                f"minimap_lost={minimap_lost}"
            )
            # Drop engage-hold so recovery is not overwritten by combat next frame
            try:
                self.clear_engage()
                self._reset_directional_attack_turn()
            except Exception:
                pass

        elapsed = now - float(self.recovery_since)
        halt_after = float(cfg.get("halt_after_sec", 45))
        if elapsed >= halt_after:
            self.halt_for_recovery(
                f"stuck/off-route too long ({elapsed:.1f}s >= {halt_after}s)"
            )
            self.cmd_move_x = "none"
            self.cmd_move_y = "none"
            self.cmd_action = "none"
            return True

        prefer_route = cfg.get("prefer_route", True)
        if isinstance(prefer_route, str):
            prefer_route = prefer_route.strip().lower() in ("1", "true", "yes", "on")

        route_has_move = False
        if prefer_route:
            try:
                self.update_cmd_by_route()
                self.check_reach_goal()
            except Exception as e:
                logger.debug(f"[Recovery] update_cmd_by_route failed: {e}")
            # Never keep attack commands from any path while recovering
            if self.cmd_action in ("attack", "aoe_attack"):
                self.cmd_action = "none"
            # Treat "goal" as progress (route switch), not as idle
            if self.cmd_move_x in ("left", "right") or self.cmd_move_y in ("up", "down"):
                route_has_move = True
            elif self.cmd_action in ("jump", "teleport", "goal"):
                route_has_move = True

        random_after = float(cfg.get("random_after_sec", 8))
        allow_jump = cfg.get("random_allow_jump", False)
        if isinstance(allow_jump, str):
            allow_jump = allow_jump.strip().lower() in ("1", "true", "yes", "on")
        reissue = float(cfg.get("random_reissue_sec", 1.5))

        # After random_after_sec still recovering: periodically soft-random.
        # Route is tried every frame first; random only overwrites on reissue beats
        # so ineffective route color codes do not block unstuck forever.
        if elapsed >= random_after:
            if now - float(getattr(self, "t_last_recovery_random", 0.0)) >= reissue:
                self.update_cmd_by_random(allow_jump=bool(allow_jump))
                self.t_last_recovery_random = now
        elif not route_has_move and prefer_route:
            # Waiting for random_after: hold still / last route cmd, no jump spam
            if self.cmd_action in ("attack", "aoe_attack", "jump"):
                self.cmd_action = "none"

        pause_attack = cfg.get("pause_attack", True)
        if isinstance(pause_attack, str):
            pause_attack = pause_attack.strip().lower() in ("1", "true", "yes", "on")
        if pause_attack and self.cmd_action in ("attack", "aoe_attack"):
            self.cmd_action = "none"

        if now - float(getattr(self, "t_last_recovery_log", 0.0)) > 3.0:
            logger.warning(
                "[Recovery] Navigating back "
                f"(elapsed={elapsed:.1f}s route_move={route_has_move} "
                f"cmd={self.cmd_move_x} {self.cmd_move_y} {self.cmd_action})"
            )
            self.t_last_recovery_log = now

        return True

    def update_cmd_by_random(self, allow_jump=False):
        """Pick a random stuck-recovery action; always move left or right.

        Default allow_jump=False (soft random): left/right only, no down-jump spam.
        Pass allow_jump=True only when an explicit caller wants jump.
        """
        self.cmd_move_x = random.choice(["left", "right"])
        if allow_jump:
            self.cmd_move_y = random.choice(["down", "none"])
            self.cmd_action = random.choice(["jump", "none"])
        else:
            self.cmd_move_y = "none"
            self.cmd_action = "none"
        logger.warning(
            "[update_cmd_by_random]"
            f"{self.cmd_move_x} {self.cmd_move_y} {self.cmd_action}"
            f" (jump={allow_jump})"
        )

    def check_reach_goal(self):
        if self.cmd_action == "goal":
            # Switch to next route map
            self.idx_routes = (self.idx_routes+1)%len(self.img_routes)
            logger.debug(f"Change to new route:{self.idx_routes}")

    def run_once(self):
        '''
        Process one game window frame
        '''
        # Start profiler for performance debugging
        self.profiler.start()

        # Check if need viz window
        self.is_show_debug_window = self.is_need_show_debug_window
        self._nametag_run_this_frame = None

        ###########################
        ### Image Preprocessing ###
        ###########################
        # Get game window frame
        img_frame = self.get_img_frame()
        if img_frame is None:
            if not is_mac():
                activate_game_window(self.capture.window_title)
            return -1 # Wait for game window to be ready
        else:
            self.img_frame = img_frame

        # Grayscale only when nametag matching actually needs it this frame.
        if self._need_frame_gray():
            self.img_frame_gray = cv2.cvtColor(self.img_frame, cv2.COLOR_BGR2GRAY)
        else:
            self.img_frame_gray = None

        # Full-frame copy is expensive; skip when monitor is closed, and when open
        # only copy on throttled overlay/recording ticks.
        if self._need_debug_canvas_this_frame():
            self.img_frame_debug = self.img_frame.copy()
        else:
            self.img_frame_debug = None

        # Get current route image
        if self.cfg["bot"]["mode"] == "normal":
            self.img_route = self.img_routes[self.idx_routes]
            self.img_route_debug = cv2.cvtColor(self.img_route, cv2.COLOR_RGB2BGR)
        else:
            self.img_route_debug = np.zeros((10, 10, 3), dtype=np.uint8)

        self.profiler.mark("Image Preprocessing")

        ###################
        ### Get Minimap ###
        ###################
        # Get minimap coordinate and size on game window
        minimap_result = get_minimap_loc_size(self.img_frame)
        if minimap_result is None:
            if time.time() - self.t_last_minimap_detection_warning > 5.0:
                logger.warning(
                    "Minimap not detected. Keep the top-left minimap expanded "
                    "and visible."
                )
                self.t_last_minimap_detection_warning = time.time()
            if time.time() - self.t_last_minimap_update > 30:
                # Unable to get minimap for 30 seconds -> assume it's login screen
                loc_login_button = self.get_login_button_location()
                if loc_login_button:
                    logger.info("Found login button on screen. Proceed to login.")
                    click_in_game_window(self.capture.window_title,
                                         loc_login_button)
                    time.sleep(3)
                    click_in_game_window(self.capture.window_title,
                                         self.cfg["ui_coords"]["select_character"])
                    time.sleep(2)
        else:
            x, y, w, h = minimap_result
            if minimap_result != self.last_minimap_geometry:
                logger.info(f"[Minimap] Located frame: {minimap_result}")
                self.last_minimap_geometry = minimap_result
            # Shrink minimap boardary by one pixel to avoid pixel leaking to minimap
            x += 1
            y += 1
            w -= 2
            h -= 2
            # update minimap image
            self.loc_minimap = (x, y)
            self.img_minimap = self.img_frame[y:y+h, x:x+w]
            self.t_last_minimap_update = time.time()

        self.profiler.mark("Get Minimap Location and Size")

        # Update health monitor with current frame
        self.health_monitor.update_frame(self.img_frame[self.cfg["ui_coords"]["ui_y_start"]:, :])

        #################################
        ### Player Location Detection ###
        #################################
        # Get player location using the configured fallback strategy. Party UI is optional.
        loc_player = self.get_player_location()

        # Update player location
        if loc_player is not None:
            # Check if character is on ladder
            dx = abs(loc_player[0] - self.loc_player[0])
            dy = abs(loc_player[1] - self.loc_player[1])
            if self.is_on_ladder:
                if dx > 3: # Leave ladder if there is horizontal move
                    self.is_on_ladder = False
            else:
                if dx < 3 and dy != 0:
                    self.is_on_ladder = True
            # logger.info((self.is_on_ladder, dx, dy))
            # Update player location
            self.loc_player = loc_player

        # Draw player center for debugging
        if self.img_frame_debug is not None:
            cv2.circle(self.img_frame_debug,
                    self.loc_player, radius=3,
                    color=(0, 0, 255), thickness=-1)

        # Get player location on minimap
        loc_player_minimap = get_player_location_on_minimap(
                                self.img_minimap,
                                minimap_player_color=self.cfg["minimap"]["player_color"])
        if loc_player_minimap:
            self.loc_player_minimap = loc_player_minimap
            self.is_player_minimap_detected = True
        else:
            self.is_player_minimap_detected = False
            if time.time() - self.t_last_player_minimap_warning > 5.0:
                logger.warning(
                    "[Minimap] Player marker not detected in captured minimap."
                )
                self.t_last_player_minimap_warning = time.time()

        # Get other player location on minimap
        loc_other_players = get_all_other_player_locations_on_minimap(
                                self.img_minimap,
                                self.cfg['minimap']['other_player_color'])
        # Debug
        # if self.is_first_frame:
        #     logger.info("Running minimap color analysis...")
        #     debug_minimap_colors(self.img_minimap, other_player_color)

        # Get player location on global map
        if self.cfg["bot"]["mode"] in ["patrol", "aux", "smart_patrol"]:
            self.loc_player_global = self.loc_player_minimap
        else:
            self.loc_player_global = self.get_player_location_on_global_map()

        self.profiler.mark("Player Location Detection")

        ######################
        ### Change Channel ###
        ######################
        if self.cfg['channel_change']['enable'] and \
            self.is_need_change_channel(loc_other_players):
            self.kb.set_command("none none none")
            self.kb.release_all_key()
            self.kb.disable()
            time.sleep(1)
            self.channel_change()
            self.red_dot_center_prev = None
            return 0

        if self.is_time_to_change_channel():
            self.kb.set_command("none none none")
            self.kb.release_all_key()
            self.kb.disable()
            time.sleep(1)
            self.channel_change()
            return 0

        self.profiler.mark("Change Channel")

        #######################
        ### Attack WatchDog ###
        ####################### Check if last attack is timeout
        dt = time.time() - self.t_last_attack
        if self.cfg['bot']['mode'] == 'normal' and \
            dt > self.cfg["watchdog"]["last_attack_timeout"]:
            logger.info(f"[Attack Timeout] Last attack timeout for {round(dt, 2)} seconds")
            cfg_action = self.cfg["watchdog"]["last_attack_timeout_action"]
            if cfg_action == "change_channel":
                logger.info("[Attack Timeout] Change channel!")
                self.channel_change()
            elif cfg_action == "go_home":
                logger.info("[Attack Timeout] Return home!")
                press_key(self.cfg["key"]["return_home"])
                # Terminate Autobot
                self.is_terminated = True
                self.kb.is_terminated = True
            else:
                logger.info(f"Unsupported timeout mode: {cfg_action}")

        self.profiler.mark("Attack WatchDog")

        ######################
        ### Hit React (HP) ###
        ######################
        # Track HP each frame; HuntingState applies retreat if armed
        self.update_hit_react_from_hp()

        ######################
        ### State Behavior ###
        ######################
        self.fsm.do_state_stuff()

        self.is_first_frame = False

        self.profiler.mark("State per-frame behavior")

        #####################
        ### Debug Windows ###
        #####################
        # Don't show debug window to save system resource
        self.debug_ui_updated = False
        self.route_viz_updated = False
        if not self.is_show_debug_window:
            self.t_last_frame = time.time()
            return 0 # frame done

        now = time.time()
        # Overlay copy already decided at frame start (_need_debug_canvas_this_frame).
        if self._debug_canvas_this_frame and self.img_frame_debug is not None:
            self.update_info_on_img_frame_debug()
            self.t_last_debug_ui = now
            self.debug_ui_updated = True

            # Save debug window to video (only when we refresh the overlay)
            if self.video_writer:
                self.video_writer.write(self.img_frame_debug)

        # Build a polished display-only route overview. The raw RGB route image
        # remains untouched because its exact pixels drive navigation.
        if self.cfg["bot"]["mode"] == "normal":
            route_viz_fps = max(
                1.0,
                float(self.cfg["system"].get(
                    "fps_limit_route_visualization", 5
                )),
            )
            if now - self.t_last_route_viz >= 1.0 / route_viz_fps:
                route_bgr = cv2.cvtColor(self.img_route, cv2.COLOR_RGB2BGR)
                route_actions = dict(self.color_code)
                route_actions.update(self.color_code_up_down)
                viewport = (
                    self.loc_minimap_global[0],
                    self.loc_minimap_global[1],
                    self.img_minimap.shape[1],
                    self.img_minimap.shape[0],
                )
                self.img_route_viz = render_route_visualization(
                    self.img_map,
                    route_bgr,
                    route_actions,
                    player_position=self.loc_player_global,
                    viewport=viewport,
                    current_command=(
                        f"{self.cmd_move_x} {self.cmd_move_y} {self.cmd_action}"
                    ),
                    scale=self.cfg["minimap"]["debug_window_upscale"],
                    crop=True,
                    show_legend=True,
                )
                self.img_route_debug = self.img_route_viz
                self.t_last_route_viz = now
                self.route_viz_updated = True

        self.profiler.mark("Debug Window Show")

        # Update FPS timer
        self.t_last_frame = time.time()

        # Print profiler result
        if self.cfg["profiler"]["enable"] and \
            self.profiler.total_frames % self.cfg["profiler"]["print_frequency"] == 0:
            logger.info('\n' + self.profiler.report())

        return 0 # frame done

    def loop(self):
        '''
        Auto Bot main loop
        Only run when call autobot from UI framework and AutoBotController
        '''
        # Make sure player is in party
        if not is_mac() and self.cfg["party_red_bar"].get("enable", False):
            activate_game_window(self.capture.window_title)
            time.sleep(0.3)
            self.ensure_is_in_party()

        while not self.kb.is_terminated:

            t_start = time.time()

            # Process one game window frame
            self.is_frame_done = False
            try:
                ret = self.run_once()
            except Exception:
                logger.exception(
                    "[MapleStoryAutoBot.loop] Frame processing failed; "
                    "keyboard control has been stopped"
                )
                self.kb.disable()
                self.kb.release_all_key()
                self.kb.is_terminated = True
                break

            # Only proceed if the frame is valid
            if ret == 0:
                # Draw image on debug window (throttled + downscaled for Qt)
                if self.is_show_debug_window and self.is_ui:
                    if self.debug_ui_updated and self.img_frame_debug is not None:
                        ui_y = int(self.cfg["ui_coords"].get("ui_y_start", 610))
                        frame_emit = self.img_frame_debug[:ui_y, :]
                        scale = float(self.cfg["system"].get("debug_ui_scale", 0.5))
                        if 0.1 <= scale < 0.999:
                            frame_emit = cv2.resize(
                                frame_emit,
                                None,
                                fx=scale,
                                fy=scale,
                                interpolation=cv2.INTER_AREA,
                            )
                        else:
                            frame_emit = frame_emit.copy()
                        self.image_debug_signal.emit(frame_emit)
                    if self.route_viz_updated and self.img_route_viz is not None:
                        self.route_map_viz_signal.emit(self.img_route_viz.copy())
            else:
                pass
                # logger.warning("Skipped debug window update due to invalid frame.")

            self.is_frame_done = True

            # Cap FPS to save system resource
            frame_duration = time.time() - t_start
            fps_limit_main = float(self.cfg["system"].get("fps_limit_main", 20) or 20)
            target_duration = 1.0 / max(1.0, fps_limit_main)
            # Sleep only if this tick finished early; heavy frames are never padded.
            if frame_duration < target_duration:
                time.sleep(target_duration - frame_duration)

def main(args):
    '''
    This main function works as a fake autoBotController
    This function will only be called when the using terminal to
    run this script
    '''
    #####################
    ### Init Auto Bot ###
    #####################
    try:
        mapleStoryAutoBot = MapleStoryAutoBot(args)
    except Exception as e:
        logger.error(f"MapleStoryAutoBot Init failed: {e}")
        sys.exit(1)
    else:
        logger.info("MapleStoryAutoBot Init Successfully")

    ####################
    ### Apply Config ###
    ####################
    # Load defautl yaml config
    cfg = load_yaml("config/config_default.yaml")
    # Override with platform config
    if is_mac():
        cfg = override_cfg(cfg, load_yaml("config/config_macOS.yaml"))
    # Override with user customized config
    cfg = override_cfg(cfg, load_yaml(f"config/config_{args.cfg}.yaml"))
    # Dump config to log for debugging
    logger.debug(yaml.dump(cfg, sort_keys=False,
                 indent=2, default_flow_style=False))
    # autoBot load config
    mapleStoryAutoBot.load_config(cfg)

    #####################
    ### Start AutoBot ###
    #####################
    try:
        mapleStoryAutoBot.start() # Start all threads in autoBot
    except Exception as e:
        logger.error(f"MapleStoryAutoBot start failed: {e}")
        mapleStoryAutoBot.terminate_threads() # Terminate all threads
        sys.exit(1)
    else:
        logger.info("MapleStoryAutoBot Start Successfully")

    # Start record game window for debugging
    if args.record:
        mapleStoryAutoBot.start_record()

    kb_listener = KeyBoardListener(is_autobot=True)
    kb_listener.register_func_key_handler('f1', mapleStoryAutoBot.kb.toggle_enable)
    kb_listener.register_func_key_handler('f2', mapleStoryAutoBot.screenshot_img_frame)
    kb_listener.register_func_key_handler('f12', mapleStoryAutoBot.terminate_threads)

    # While loop
    while not mapleStoryAutoBot.is_terminated:
        # Show debug image on window
        if mapleStoryAutoBot.is_frame_done:
            if mapleStoryAutoBot.img_frame_debug is not None:
                cv2.imshow("Game Window Debug",
                    mapleStoryAutoBot.img_frame_debug[:
                        mapleStoryAutoBot.cfg["ui_coords"]["ui_y_start"], :])

            if mapleStoryAutoBot.img_route_debug is not None:
                cv2.imshow("Route Map Debug", mapleStoryAutoBot.img_route_debug)

        cv2.waitKey(1)

        time.sleep(0.01)

    #########################
    ### Terminate AutoBot ###
    #########################
    mapleStoryAutoBot.terminate_threads() # Terminate all threads

    cv2.destroyAllWindows()

