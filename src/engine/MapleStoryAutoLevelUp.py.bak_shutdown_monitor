    def load_config(self, cfg):
        '''
        load_config
        '''
        # Maps and monster associations can be edited from the UI after the
        # controller is constructed, so refresh the resource catalog on start.
        self.data = load_yaml("config/config_data.yaml")
        resource_override_path = "config/config_resource_overrides.yaml"
        if os.path.exists(resource_override_path):
            self.data = override_cfg(self.data, load_yaml(resource_override_path))
        self.monsters_info.clear()
        self.monsters_contour_patterns = {}

        # Parse color code in config
        self.color_code = {
            tuple(map(int, k.split(','))): v
            for k, v in cfg["route"]["color_code"].items()
        }
        self.color_code_up_down = {
            tuple(map(int, k.split(','))): v
            for k, v in cfg["route"]["color_code_up_down"].items()
        }

        if cfg["bot"]["mode"] in ("normal", "smart_patrol"):
            map_name = cfg['bot']['map']
            # Check if the map is supported in config_data.yaml
            if map_name not in self.data["map_mobs_mapping"]:
                text = f"Invalid map name: {map_name}. "\
                        "Not supported in config/config_data.yaml."
                logger.error(text)
                return -1
                # raise RuntimeError(text)

            if cfg["bot"]["mode"] == "normal":
                # Load map.png from assets/minimaps/
                self.img_map = load_image(f"{MINIMAPS}/{map_name}/map.png",
                                          cv2.IMREAD_COLOR)
                # Load route*.png from assets/minimaps/
                route_files = sorted(glob.glob(f"{MINIMAPS}/{map_name}/route*.png"))
                route_files = [p for p in route_files if not p.endswith("route_rest.png")]
                if not route_files:
                    logger.error(f"No route images found in {MINIMAPS}/{map_name}/")
                    return -1
                self.img_routes = []
                for route_file in route_files:
                    img = cv2.cvtColor(load_image(route_file), cv2.COLOR_BGR2RGB)
                    # Remove pixel in map that is color code
                    img = mask_route_colors(self.img_map, img, cfg["route"]["color_code"])
                    img = mask_route_colors(self.img_map, img, cfg["route"]["color_code_up_down"])
                    self.img_routes.append(img)
            else:
                # smart_patrol: minimap scan + engage; route PNGs not required
                self.img_map = None
                self.img_routes = []
                logger.info('[load_config] smart_patrol: map=%s, skipping route PNGs (Scan uses live minimap)' % (map_name,))
                # P2: load recorded rope edges for layer Return
                self.rope_doc = load_ropes(map_name)
                self.rope_edges = list(self.rope_doc.get("edges") or [])
                logger.info('[load_config] smart_patrol ropes: %s edge(s) from %s' % (len(self.rope_edges), ropes_path(map_name)))
                # Per-map bounds from assets/minimaps/{map}/patrol.yaml (if present)
                cfg["smart_patrol"] = merge_patrol_into_smart_patrol(
                    cfg.get("smart_patrol") or {}, map_name
                )
                self.cfg = cfg
                if cfg["smart_patrol"].get("preferred_y") is not None:
                    self.rope_doc["preferred_y"] = cfg["smart_patrol"]["preferred_y"]
                if cfg["smart_patrol"].get("preferred_y_tol") is not None:
                    self.rope_doc["preferred_y_tol"] = cfg["smart_patrol"]["preferred_y_tol"]
                logger.info(
                    '[load_config] smart_patrol bounds: range=%s preferred_y=%s rope_enable=%s'
                    % (
                        cfg["smart_patrol"].get("range"),
                        cfg["smart_patrol"].get("preferred_y"),
                        cfg["smart_patrol"].get("rope_enable"),
                    )
                )
                # Soft note only (no QMessageBox / status nag): empty ropes disable Return.
                self.startup_warnings = []
                rope_enable = cfg["smart_patrol"].get("rope_enable", False)
                if isinstance(rope_enable, str):
                    rope_enable = rope_enable.strip().lower() in ("1", "true", "yes", "on")
                if rope_enable and len(self.rope_edges) == 0:
                    logger.info(
                        "[load_config] smart_patrol: rope_enable=true but ropes.yaml edges=[] "
                        "(map=%s) — Return disabled until ropes are recorded. No modal warning."
                        % (map_name,)
                    )


            # Load monsters images from assets/monster/<monster_name>
            alpha_threshold = cfg["monster_detect"].get("alpha_threshold", 32)
            template_scales = cfg["monster_detect"].get("template_scales", (1.0,))
            # Prefer living poses; die/hit frames rarely help Hybrid/AoE and burn FPS.
            name_prefixes = cfg["monster_detect"].get(
                "template_name_prefixes", ["stand"]
            )
            if isinstance(name_prefixes, str):
                name_prefixes = [name_prefixes]
            name_prefixes = [str(p).lower() for p in (name_prefixes or []) if str(p).strip()]
            max_files = int(cfg["monster_detect"].get("template_max_files_per_monster", 4) or 0)
            for monster_name in self.data["map_mobs_mapping"].get(map_name, []):
                imgs = []
                monster_files = sorted(glob.glob(f"{MONSTER}/{monster_name}/*"))
                monster_files = [
                    file for file in monster_files
                    if os.path.splitext(file)[1].lower() in (".png", ".jpg", ".jpeg", ".bmp")
                ]
                if name_prefixes:
                    filtered = []
                    for file in monster_files:
                        base = os.path.basename(file).lower()
                        if any(base.startswith(prefix) for prefix in name_prefixes):
                            filtered.append(file)
                    monster_files = filtered
                def _monster_file_sort_key(path):
                    base = os.path.basename(path).lower()
                    if base.startswith("stand"):
                        return (0, base)
                    if base.startswith("move"):
                        return (1, base)
                    return (2, base)
                monster_files = sorted(monster_files, key=_monster_file_sort_key)
                if max_files > 0:
                    monster_files = monster_files[:max_files]
                for file in monster_files:
                    try:
                        img_base, mask_base = load_monster_template(
                            file,
                            alpha_threshold=alpha_threshold,
                        )
                    except (FileNotFoundError, ValueError) as error:
                        logger.warning(str(error))
                        continue

                    for scale in template_scales:
                        scale = float(scale)
                        if scale <= 0:
                            logger.warning(f"Ignore invalid monster template scale: {scale}")
                            continue
                        if scale == 1.0:
                            img = img_base
                            mask = mask_base
                        else:
                            img = cv2.resize(
                                img_base,
                                None,
                                fx=scale,
                                fy=scale,
                                interpolation=cv2.INTER_NEAREST,
                            )
                            mask = cv2.resize(
                                mask_base,
                                (img.shape[1], img.shape[0]),
                                interpolation=cv2.INTER_NEAREST,
                            )

                        imgs.append((img, mask))
                        imgs.append((cv2.flip(img, 1), cv2.flip(mask, 1)))
                if imgs:
                    self.monsters_info[monster_name] = imgs
                    logger.info(
                        f"[load_config] {MONSTER}/{monster_name}: "
                        f"{len(monster_files)} files -> {len(imgs)} templates "
                        f"(incl. flips/scales)"
                    )
                else:
                    logger.warning(f"No usable images found in {MONSTER}/{monster_name}/")
            # Pre-blur contour patterns once so hunting does not redo it every frame.
            blur = int(cfg["monster_detect"].get("contour_blur", 5) or 5)
            if blur < 1:
                blur = 1
            if blur % 2 == 0:
                blur += 1
            self.monsters_contour_patterns = {}
            for monster_name, pairs in self.monsters_info.items():
                patterns = []
                for img, mask in pairs:
                    black_pixels = np.all(img == [0, 0, 0], axis=2)
                    visible_pixels = mask > 0
                    mask_pattern = (black_pixels & visible_pixels).astype(np.uint8) * 255
                    patterns.append(cv2.GaussianBlur(mask_pattern, (blur, blur), 0))
                self.monsters_contour_patterns[monster_name] = patterns
            logger.info(f"Loaded monsters: {list(self.monsters_info.keys())}")

        # Load player's name tag
        self.img_nametag = None
        self.img_nametag_gray = None
        self.nametag_match_valid = False
        self.nametag_miss_count = 0
        self.nametag_last_size = (0, 0)
        self.nametag_last_score = 1.0
        if cfg["nametag"]["enable"]:
            nametag_path = f"{NAMETAG}/{cfg['nametag']['name']}.png"
            if os.path.exists(nametag_path):
                loaded_nametag = load_image(nametag_path)
                trimmed_nametag = prepare_nametag_template(loaded_nametag)
                if trimmed_nametag.shape[:2] != loaded_nametag.shape[:2]:
                    logger.info(
                        "[load_config] Trimmed nametag template "
                        f"{loaded_nametag.shape[1]}x{loaded_nametag.shape[0]} -> "
                        f"{trimmed_nametag.shape[1]}x{trimmed_nametag.shape[0]}"
                    )
                self.img_nametag = trimmed_nametag
                self.img_nametag_gray = cv2.cvtColor(trimmed_nametag, cv2.COLOR_BGR2GRAY)
            else:
                self.img_nametag = None
                self.img_nametag_gray = None
                logger.warning(f"Nametag image not found: {nametag_path}; fallback detection will be used")

        # Load feature-specific images. Missing optional assets must not prevent
        # normal route execution from starting.
        lang = cfg["system"]["language"]
        if cfg["party_red_bar"].get("enable", False):
            self.img_create_party_enable = load_optional_image(
                f"{MISC}/party_button_create_enable_{lang}.png"
            )
            self.img_create_party_disable = load_optional_image(
                f"{MISC}/party_button_create_disable_{lang}.png"
            )
        else:
            self.img_create_party_enable = None
            self.img_create_party_disable = None
        self.img_login_button = load_optional_image(f"{MISC}/login_button_{lang}.png")

        # Normalized pixel coordinate configuration
        cfg['ui_coords']['login_button_top_left'] = normalize_pixel_coordinate(
            cfg['ui_coords']['login_button_top_left'], cfg['game_window']['size'])
        cfg['ui_coords']['login_button_bottom_right'] = normalize_pixel_coordinate(
            cfg['ui_coords']['login_button_bottom_right'], cfg['game_window']['size'])

        # Print mode on log
        logger.info(f"[load_config] Config AutoBot as {cfg['bot']['mode']} mode")

        # Update cfg
        self.cfg = cfg

        return 0 # load successfully

    def start(self):
        '''
        Start all threads
        '''
        self.is_terminated = False

        # Establish a valid video feed before starting any thread that can press
        # keys. This prevents buffs/actions from running against a blind bot.
        if self.args.test_image == '':
            self.capture = GameWindowCapturor(self.cfg)
        else:
            self.capture = GameWindowCapturor(self.cfg, self.args.test_image)

        first_frame = self._wait_for_valid_game_frame(timeout=4.0)
        if first_frame is None and not is_mac() and self.args.test_image == '':
            logger.warning(
                "[MapleStoryAutoBot] Windows capture produced no valid frame; "
                "falling back to MSS"
            )
            self.capture.stop()
            self.capture = GameWindowCapturor(self.cfg, backend="mss")
            first_frame = self._wait_for_valid_game_frame(timeout=4.0)

        if first_frame is None:
            if self.capture is not None:
                self.capture.stop()
            raise RuntimeError(
                "无法获取有效游戏画面，控制线程未启动。请确认游戏窗口可见、"
                "处于窗口模式且分辨率正确。"
            )

        self.img_frame = first_frame
        logger.info(
            f"[MapleStoryAutoBot] Capture ready via "
            f"{getattr(self.capture, 'backend', 'default')}: "
            f"source {self.frame.shape[:2]} -> normalized {first_frame.shape[:2]}"
        )

        # Start keyboard controller only after capture readiness is confirmed.
        self.kb = KeyBoardController(self.cfg)
        if self.is_disable_control:
            self.kb.disable() # Disable keyboard controller for debugging

        # Start health monitoring thread
        self.health_monitor = HealthMonitor(self.cfg, self.kb)
        if self.cfg["health_monitor"]["enable"] and \
            not self.is_disable_control:
            self.health_monitor.start()

        # Init profiler
        self.profiler = Profiler(self.cfg)

        # Reset all timers
        self.t_last_frame = time.time()
        self.t_watch_dog = time.time()
        self.t_last_teleport = time.time()
        self.t_last_attack = time.time()
        self.t_last_aoe_attack = time.time()
        self.t_next_aoe_attack = 0.0
        self.recovery_since = None
        self.recovery_clear_since = None
        self.t_minimap_lost_since = None
        self.t_last_stuck_log = 0.0
        self.t_last_recovery_random = 0.0
        self.t_last_recovery_log = 0.0
        self.hybrid_aoe_monster_count = 0
        self.combat_turn_ready_at = 0.0
        self.combat_turn_pending_direction = None
        self.combat_turn_requested_at = 0.0
        self.t_last_minimap_update = time.time()
        self.t_to_change_channel = time.time()
        self.t_last_route_viz = 0.0
        self.route_viz_updated = False
        self.t_last_debug_ui = 0.0
        self.debug_ui_updated = False
        self._debug_canvas_this_frame = False
        self._monster_detect_tick = 0
        self._nametag_scan_tick = 0
        self._nametag_run_this_frame = None
        self.img_route_viz = None

        # Set init state
        if self.args.init_state != "":
            self.fsm.set_init_state(self.args.init_state) # For debugging
        elif self.cfg["bot"]["mode"] == "aux":
            self.fsm.set_init_state("aux")
        elif self.cfg["bot"]["mode"] == "patrol":
            self.fsm.set_init_state("patrol")
        elif self.cfg["bot"]["mode"] == "smart_patrol":
            self.fsm.set_init_state("smart_patrol")
        else:
            self.fsm.set_init_state("hunting")

        # Start Auto Bot main thread
        self.thread_auto_bot = threading.Thread(target=self.loop)
        self.thread_auto_bot.start()
        self.is_first_frame = True

        logger.info("[MapleStoryAutoBot] Started")

    def _wait_for_valid_game_frame(self, timeout=4.0):
        """Return the first valid processed frame, or None before timeout."""
        deadline = time.time() + timeout
        first_wait = True
        while time.time() < deadline:
            try:
                if first_wait and hasattr(self.capture, "wait_for_frame"):
                    self.capture.wait_for_frame(min(1.0, timeout))
                    first_wait = False
                img_frame = self.get_img_frame(log_failure=False)
            except Exception as error:
                logger.warning(f"[MapleStoryAutoBot] Capture unavailable: {error}")
                return None
            if img_frame is not None:
                return img_frame
            time.sleep(0.05)
        return None

